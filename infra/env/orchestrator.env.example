APP_NAME=BuildWealth Orchestrator
APP_ENV=local
APP_CURRENCY=USD
APP_STATE=MN

# Storage
SNAPSHOT_DIR=data/snapshots
DURABLE_STORAGE_DIR=data/storage
BACKUP_ARCHIVE_DIR=data/backups
PROTECTION_POLICY_PATH=data/security/protection_policy.json
IGNIDASH_EXPORT_DIR=data/ignidash
IMPORT_INBOX_DIR=data/imports/inbox
IMPORT_ARCHIVE_DIR=data/imports/archive
CONVERSATION_DIR=data/conversations
PLANS_DIR=data/plans

# Sidecar adapters (optional; keep disabled for default standalone mode)
GHOSTFOLIO_SIDECAR_BASE_URL=http://localhost:8411
GHOSTFOLIO_BENCHMARK_SIDECAR_PATH=/v1/benchmark/compare
GHOSTFOLIO_ATTRIBUTION_SIDECAR_PATH=/v1/attribution/compute
ENABLE_GHOSTFOLIO_BENCHMARK_SIDECAR=false
ENABLE_GHOSTFOLIO_ATTRIBUTION_SIDECAR=false
GHOSTFOLIO_SIDECAR_HEALTH_PATHS=/health,/api/v1/health
GHOSTFOLIO_SIDECAR_CONTRACT_VERSION=1

IGNIDASH_SIDECAR_BASE_URL=http://localhost:8412
IGNIDASH_SCENARIO_SIDECAR_PATH=/v1/scenario/simulate
ENABLE_IGNIDASH_SCENARIO_SIDECAR=false
IGNIDASH_SIDECAR_HEALTH_PATHS=/health,/api/health
IGNIDASH_SIDECAR_CONTRACT_VERSION=1

ENGINE_SIDECAR_TIMEOUT_SECONDS=3
ENGINE_SIDECAR_RETRY_COUNT=1
ENGINE_HEALTH_PROBE_INTERVAL_SECONDS=60
ENGINE_SIDECAR_VERSION_PATHS=/version

# Planning defaults (baseline assumptions)
PLANNER_YEARS_TO_RETIREMENT=30
PLANNER_ANNUAL_CONTRIBUTION_USD=18000
PLANNER_EXPECTED_RETURN_BASELINE=0.065
PLANNER_EXPECTED_RETURN_OPTIMISTIC=0.085
PLANNER_EXPECTED_RETURN_CONSERVATIVE=0.045
PLANNER_RETURN_VOLATILITY=0.14
PLANNER_INFLATION=0.025
PLANNER_MONTE_CARLO_RUNS=2000
PLANNER_HSA_DELTA_DEFAULT=1000
PLANNER_MARGINAL_TAX_RATE=0.28

# Optional LLM and OpenBB
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_PARALLEL_TOOL_CALLS=true
OPENBB_PROVIDER=yfinance
COPILOT_MAX_HISTORY_MESSAGES=24
COPILOT_MAX_TOOL_ROUNDS=6
COPILOT_CONTEXT_CACHE_ENABLED=true
COPILOT_CONTEXT_CACHE_MAX_ENTRIES=128
COPILOT_CONTEXT_RESEARCH_CACHE_TTL_SECONDS=180
COPILOT_CONTEXT_PROJECTION_CACHE_TTL_SECONDS=120
COPILOT_CONTEXT_SNAPSHOT_STALE_AFTER_SECONDS=86400

# Automation
SYNC_INTERVAL_MINUTES=0
