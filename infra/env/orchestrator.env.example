APP_NAME=BuildWealth Orchestrator
APP_ENV=local
APP_CURRENCY=USD
APP_STATE=MN

# Auth
# AUTH_MODE=dev uses the default local developer workspace.
# AUTH_MODE=local enables BuildWealth-owned email/password auth.
# AUTH_MODE=hosted uses a configured OIDC provider and disables local password login.
AUTH_MODE=dev
AUTH_SESSION_COOKIE_NAME=buildwealth_session
AUTH_SESSION_DAYS=14
AUTH_DEV_EMAIL=owner@buildwealth.local

# Hosted identity provider
# Recommended first private-beta provider: Auth0.
# See docs/HOSTED_IDENTITY_PROVIDER_DECISION_2026-05-14.md.
AUTH_OIDC_PROVIDER_NAME=Auth0
AUTH_OIDC_ISSUER_URL=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_SECRET=
AUTH_OIDC_REDIRECT_URI=
AUTH_OIDC_TOKEN_AUTH_METHOD=client_secret_basic
AUTH_OIDC_SCOPES="openid email profile"
AUTH_OIDC_REQUIRE_ID_TOKEN=true
AUTH_OIDC_ALLOWED_ID_TOKEN_ALGS=RS256
AUTH_OIDC_REQUIRE_MFA=false
AUTH_OIDC_JWKS_URI=
AUTH_OIDC_AUTHORIZATION_ENDPOINT=
AUTH_OIDC_TOKEN_ENDPOINT=
AUTH_OIDC_USERINFO_ENDPOINT=
AUTH_OIDC_LOGOUT_URL=
AUTH_POST_LOGIN_REDIRECT_PATH=/v2
AUTH_POST_LOGOUT_REDIRECT_URI=
AUTH_ACCOUNT_MANAGEMENT_URL=
AUTH_PASSWORD_RESET_URL=
AUTH_MFA_ENROLLMENT_URL=
AUTH_PASSKEY_ENROLLMENT_URL=

# Storage
CONTROL_DB_PATH=data/control/control.db
WORKSPACE_ROOT_DIR=data/workspaces
SECRET_KEY_PATH=data/control/local_secret.key
SNAPSHOT_DIR=data/snapshots
DURABLE_STORAGE_DIR=data/storage
BACKUP_ARCHIVE_DIR=data/backups
PROTECTION_POLICY_PATH=data/security/protection_policy.json
PORTFOLIO_REVIEW_PACKET_DIR=data/reports/portfolio_review_packets
IMPORT_INBOX_DIR=data/imports/inbox
IMPORT_ARCHIVE_DIR=data/imports/archive
IMPORT_WORKBENCH_DIR=data/imports/workbench
IMPORT_REPORTS_DIR=data/imports/reports
CONVERSATION_DIR=data/conversations
PLANS_DIR=data/plans
VERSIONED_WORKSPACE_DIR=data/versioned
GIT_INTEGRATION_SETTINGS_PATH=data/settings/git_integration.json
FINANCIAL_PROFILE_PATH=data/profile/financial_profile.json
RECOMMENDATIONS_PATH=data/recommendations/inbox.json
TODAY_REVIEW_CHECKPOINT_PATH=data/today/review_checkpoint.json

ENGINE_HEALTH_PROBE_INTERVAL_SECONDS=60

# Planning defaults (baseline assumptions)
PLANNER_YEARS_TO_RETIREMENT=30
PLANNER_ANNUAL_CONTRIBUTION_USD=18000
PLANNER_EXPECTED_RETURN_BASELINE=0.065
PLANNER_EXPECTED_RETURN_OPTIMISTIC=0.085
PLANNER_EXPECTED_RETURN_CONSERVATIVE=0.045
PLANNER_RETURN_VOLATILITY=0.14
PLANNER_INFLATION=0.025
PLANNER_MONTE_CARLO_RUNS=2000
PLANNER_HSA_DELTA_DEFAULT=1000
PLANNER_MARGINAL_TAX_RATE=0.28

# Optional LLM and OpenBB
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-5.5
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
LLM_PARALLEL_TOOL_CALLS=true
# Live provider probe tests use provider-specific keys when present:
# OPENAI_API_KEY=...
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# XAI_API_KEY=...
OPENBB_PROVIDER=yfinance
COPILOT_MAX_HISTORY_MESSAGES=24
COPILOT_MAX_TOOL_ROUNDS=6
COPILOT_CONTEXT_CACHE_ENABLED=true
COPILOT_CONTEXT_CACHE_MAX_ENTRIES=128
COPILOT_CONTEXT_RESEARCH_CACHE_TTL_SECONDS=180
COPILOT_CONTEXT_PROJECTION_CACHE_TTL_SECONDS=120
COPILOT_CONTEXT_SNAPSHOT_STALE_AFTER_SECONDS=86400

# Automation
SYNC_INTERVAL_MINUTES=0
