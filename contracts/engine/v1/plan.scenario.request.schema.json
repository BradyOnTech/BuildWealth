{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://buildwealth.local/contracts/engine/v1/plan.scenario.request.schema.json",
  "title": "Plan Scenario Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "currency",
    "start_year",
    "horizon_years",
    "household",
    "accounts",
    "baseline_assumptions",
    "scenario_overrides"
  ],
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "start_year": {
      "type": "integer",
      "minimum": 1900
    },
    "horizon_years": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "household": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_age",
        "retirement_age"
      ],
      "properties": {
        "current_age": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120
        },
        "retirement_age": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "account_id",
          "account_type",
          "tax_treatment",
          "balance"
        ],
        "properties": {
          "account_id": {
            "type": "string",
            "minLength": 1
          },
          "account_type": {
            "type": "string",
            "minLength": 1
          },
          "tax_treatment": {
            "type": "string",
            "enum": [
              "taxable",
              "tax_deferred",
              "tax_free"
            ]
          },
          "balance": {
            "type": "number"
          },
          "annual_contribution": {
            "type": "number",
            "default": 0
          }
        }
      }
    },
    "baseline_assumptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "annual_return_rate",
        "annual_inflation_rate",
        "effective_tax_rate",
        "annual_income",
        "annual_expenses"
      ],
      "properties": {
        "annual_return_rate": {
          "type": "number"
        },
        "annual_inflation_rate": {
          "type": "number"
        },
        "effective_tax_rate": {
          "type": "number"
        },
        "annual_income": {
          "type": "number"
        },
        "annual_expenses": {
          "type": "number"
        }
      }
    },
    "scenario_overrides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "label",
          "overrides"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "overrides": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "number",
                "string",
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
